# OpenRouter — model inference for the Strands runtime and (Person 2) repair.
OPENROUTER_API_KEY=sk-or-...
# Demo model: weak injection resistance + reliable tool calling, so the exploit
# reliably lands live. Swap to a frontier model (e.g. anthropic/claude-sonnet-4-5)
# for a "real" assistant; note strong models often refuse the injection.
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
